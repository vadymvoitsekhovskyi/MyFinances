<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.MyFinance" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/dark_green</item>
        <item name="colorSecondary">@color/dark_green</item>
        <item name="android:windowBackground">@color/background_main</item>
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="fontFamily">@font/manrope_medium</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="materialButtonStyle">@style/GlossyButton</item>
    </style>

    <style name="GlossyButton" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_glossy_green</item>
        <item name="android:textColor">@color/white_soft</item>
    </style>

    <style name="GlossyOutlineButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_glossy_outline</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="PinButton" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_glossy_pin</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <style name="Theme.MyFinance" parent="Base.Theme.MyFinance" />
</resources>